#include <iostream>
using namespace std;
 
int main()
{
    int N,i;
    cin>>N;
    
    for(i=2;i<=N;++i){
        
        bool is_prime=true;
        
        for(int j=2;j*j<=i;++j){
             if(i%j==0){
                 is_prime=false;
                 break;
             }
        }
        
        if(is_prime){
            cout<<i<<" ";
        }
   }
    return 0;
}
