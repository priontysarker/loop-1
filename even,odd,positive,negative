#include <iostream>
using namespace std;
 
int main()
{
    int N;
    cin>>N;
    
    int even_count=0,odd_count=0,pos_count=0,neg_count=0;
    
    for(int i=1;i<=N;++i){
        int x;
        cin>>x;
        
        if(x%2==0){
            even_count++;
        }else{
            odd_count++;
        }
        
        if(x>0){
            pos_count++;
        }else if(x<0){
            neg_count++;
        }
    }
        
        
        cout<<"Even: "<<even_count<< "\n";
         cout<<"Odd: "<<odd_count<< "\n";
          cout<<"Positive: "<<pos_count<< "\n";
           cout<<"Negative: "<<neg_count<< "\n";
        
    
 
    return 0;
}
