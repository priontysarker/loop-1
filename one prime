#include <iostream>
using namespace std;
 
int main()
{
    int X,i;
    cin>>X;
    
    bool is_prime = true;
    
    for(i=2;i<X;i++)
    {
    if(X%i==0){
        is_prime=false;
        break;
    }
    }
    
    if(is_prime){
        cout<<"YES"<< "\n";
    }else{
        cout<<"NO"<< "\n";
    }
 
 
    return 0;
}
